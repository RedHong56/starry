OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
USE_MOCK=false
PORT=8000

JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=720
FREE_COUPON_INTERVAL_HOURS=48

KAKAO_APP_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/starry

# Google Play 인앱 결제 영수증 검증
# GOOGLE_PACKAGE_NAME: Play Console의 앱 패키지명 (예: com.yourcompany.starry)
# GOOGLE_SERVICE_ACCOUNT_JSON: GCP 서비스 계정 JSON을 한 줄로 압축한 문자열
GOOGLE_PACKAGE_NAME=com.yourcompany.starry
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
